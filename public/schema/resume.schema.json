{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0xdolan.github.io/open-vitae/app/schema/resume.schema.json",
  "title": "Open Vitae resume (schemaVersion 2)",
  "description": "A resume as stored, exported and imported by Open Vitae. Import also accepts this object wrapped in an export envelope ({ \"format\": \"open-vitae\", \"resume\": … }). Every id must be unique within the resume; rich text fields hold HTML that is sanitised on display.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "layout": {
      "type": "object",
      "properties": {
        "pageSize": {
          "type": "string",
          "enum": [
            "a4",
            "letter",
            "a3",
            "a5",
            "a6",
            "b4",
            "b5",
            "jis-b5",
            "legal",
            "tabloid",
            "executive",
            "statement",
            "folio"
          ]
        },
        "orientation": {
          "type": "string",
          "enum": [
            "portrait",
            "landscape"
          ]
        },
        "marginMm": {
          "type": "number",
          "minimum": 0,
          "maximum": 50
        },
        "pageBreaks": {
          "type": "string",
          "enum": [
            "smart",
            "manual"
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "ltr",
            "rtl"
          ]
        },
        "fontFamily": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[\\p{L}\\p{N} ._-]+$"
        },
        "baseFontSizePt": {
          "type": "number",
          "minimum": 6,
          "maximum": 24
        },
        "lineHeight": {
          "type": "number",
          "minimum": 1,
          "maximum": 3
        },
        "accentColor": {
          "type": "string",
          "pattern": "^#(?:[0-9a-f]{3}|[0-9a-f]{6}|[0-9a-f]{8})$"
        },
        "indentCh": {
          "type": "number",
          "minimum": 1,
          "maximum": 12
        },
        "maxDepth": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            {
              "type": "null"
            }
          ]
        },
        "showContactIcons": {
          "type": "boolean"
        },
        "digits": {
          "type": "string",
          "enum": [
            "latn",
            "arab",
            "arabext"
          ]
        }
      },
      "required": [
        "pageSize",
        "orientation",
        "marginMm",
        "pageBreaks",
        "direction",
        "fontFamily",
        "baseFontSizePt",
        "lineHeight",
        "accentColor",
        "indentCh",
        "maxDepth"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "maxLength": 120
        },
        "headline": {
          "type": "string",
          "maxLength": 200
        },
        "email": {
          "type": "string",
          "maxLength": 254
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "location": {
          "type": "string",
          "maxLength": 120
        },
        "website": {
          "type": "string",
          "maxLength": 2048
        },
        "links": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "label": {
                "type": "string",
                "maxLength": 80
              },
              "url": {
                "type": "string",
                "maxLength": 2048
              },
              "icon": {
                "type": "object",
                "properties": {
                  "set": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]{1,32}$"
                  },
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9-]{1,80}$"
                  }
                },
                "required": [
                  "set",
                  "name"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "label",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "summaryHtml": {
          "type": "string",
          "maxLength": 2000000
        },
        "nameStyle": {
          "type": "object",
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#(?:[0-9a-f]{3}|[0-9a-f]{6}|[0-9a-f]{8})$"
            },
            "fontFamily": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[\\p{L}\\p{N} ._-]+$"
            },
            "fontSizePt": {
              "type": "number",
              "minimum": 4,
              "maximum": 96
            }
          },
          "additionalProperties": false
        },
        "headlineStyle": {
          "type": "object",
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#(?:[0-9a-f]{3}|[0-9a-f]{6}|[0-9a-f]{8})$"
            },
            "fontFamily": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[\\p{L}\\p{N} ._-]+$"
            },
            "fontSizePt": {
              "type": "number",
              "minimum": 4,
              "maximum": 96
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "fullName",
        "headline",
        "email",
        "phone",
        "location",
        "website",
        "links",
        "summaryHtml"
      ],
      "additionalProperties": false
    },
    "photo": {
      "type": "object",
      "properties": {
        "dataUrl": {
          "type": "string",
          "maxLength": 7000000,
          "pattern": "^data:image\\/(?:png|jpeg|webp);base64,[A-Za-z0-9+/]+={0,2}$"
        },
        "align": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end"
          ]
        },
        "shape": {
          "type": "string",
          "enum": [
            "square",
            "rounded",
            "circle"
          ]
        },
        "widthMm": {
          "type": "number",
          "minimum": 10,
          "maximum": 80
        },
        "source": {
          "type": "object",
          "properties": {
            "dataUrl": {
              "type": "string",
              "maxLength": 7000000,
              "pattern": "^data:image\\/(?:png|jpeg|webp);base64,[A-Za-z0-9+/]+={0,2}$"
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "crop": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0
                },
                "y": {
                  "type": "number",
                  "minimum": 0
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "rotation": {
                  "anyOf": [
                    {
                      "type": "number",
                      "const": 0
                    },
                    {
                      "type": "number",
                      "const": 90
                    },
                    {
                      "type": "number",
                      "const": 180
                    },
                    {
                      "type": "number",
                      "const": 270
                    }
                  ]
                }
              },
              "required": [
                "x",
                "y",
                "width",
                "height",
                "rotation"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "dataUrl",
            "width",
            "height",
            "crop"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "dataUrl",
        "align",
        "shape",
        "widthMm"
      ],
      "additionalProperties": false
    },
    "sections": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "experience",
              "education",
              "skills",
              "projects",
              "certifications",
              "languages",
              "awards",
              "publications",
              "volunteering",
              "references",
              "interests",
              "custom"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "visible": {
            "type": "boolean"
          },
          "breakBefore": {
            "type": "boolean"
          },
          "icon": {
            "type": "object",
            "properties": {
              "set": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,32}$"
              },
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9-]{1,80}$"
              }
            },
            "required": [
              "set",
              "name"
            ],
            "additionalProperties": false
          },
          "titleStyle": {
            "type": "object",
            "properties": {
              "color": {
                "type": "string",
                "pattern": "^#(?:[0-9a-f]{3}|[0-9a-f]{6}|[0-9a-f]{8})$"
              },
              "fontFamily": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[\\p{L}\\p{N} ._-]+$"
              },
              "fontSizePt": {
                "type": "number",
                "minimum": 4,
                "maximum": 96
              }
            },
            "additionalProperties": false
          },
          "descriptionStyle": {
            "type": "object",
            "properties": {
              "color": {
                "type": "string",
                "pattern": "^#(?:[0-9a-f]{3}|[0-9a-f]{6}|[0-9a-f]{8})$"
              },
              "fontFamily": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[\\p{L}\\p{N} ._-]+$"
              },
              "fontSizePt": {
                "type": "number",
                "minimum": 4,
                "maximum": 96
              }
            },
            "additionalProperties": false
          },
          "items": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "visible": {
                  "type": "boolean"
                },
                "title": {
                  "type": "string",
                  "maxLength": 300
                },
                "subtitle": {
                  "type": "string",
                  "maxLength": 300
                },
                "dateRange": {
                  "type": "string",
                  "maxLength": 100
                },
                "location": {
                  "type": "string",
                  "maxLength": 120
                },
                "url": {
                  "type": "string",
                  "maxLength": 2048
                },
                "descriptionHtml": {
                  "type": "string",
                  "maxLength": 2000000
                },
                "breakBefore": {
                  "type": "boolean"
                },
                "icon": {
                  "type": "object",
                  "properties": {
                    "set": {
                      "type": "string",
                      "pattern": "^[a-z0-9-]{1,32}$"
                    },
                    "name": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9-]{1,80}$"
                    }
                  },
                  "required": [
                    "set",
                    "name"
                  ],
                  "additionalProperties": false
                },
                "titleStyle": {
                  "type": "object",
                  "properties": {
                    "color": {
                      "type": "string",
                      "pattern": "^#(?:[0-9a-f]{3}|[0-9a-f]{6}|[0-9a-f]{8})$"
                    },
                    "fontFamily": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100,
                      "pattern": "^[\\p{L}\\p{N} ._-]+$"
                    },
                    "fontSizePt": {
                      "type": "number",
                      "minimum": 4,
                      "maximum": 96
                    }
                  },
                  "additionalProperties": false
                },
                "descriptionStyle": {
                  "type": "object",
                  "properties": {
                    "color": {
                      "type": "string",
                      "pattern": "^#(?:[0-9a-f]{3}|[0-9a-f]{6}|[0-9a-f]{8})$"
                    },
                    "fontFamily": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100,
                      "pattern": "^[\\p{L}\\p{N} ._-]+$"
                    },
                    "fontSizePt": {
                      "type": "number",
                      "minimum": 4,
                      "maximum": 96
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "visible",
                "title",
                "subtitle",
                "dateRange",
                "location",
                "url",
                "descriptionHtml"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "visible",
          "breakBefore",
          "items"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "language",
    "createdAt",
    "updatedAt",
    "layout",
    "profile",
    "sections"
  ],
  "additionalProperties": false
}
